---
import { Icon } from '@astrojs/starlight/components';
import SitePage from '../components/site/SitePage.astro';
import ProductIcon from '../components/site/ProductIcon.astro';
import { products, project, repoFile } from '../data/products';

const java = products['kmip-java'];
const server = products['kmip-server'];
---

<SitePage
  title="Community"
  description="How to get help with Keytend, report bugs and vulnerabilities, contribute, and what 'experimental' means for keytend-kmip and keytend-kmip-server."
>
  <section class="kt-pagehead">
    <h1 id="_top">Getting help and contributing</h1>
    <p class="kt-lead">
      Both projects are maintained as a best effort, with no service level agreement. Questions, bugs and pull requests go through GitHub. Vulnerability reports go by
      email.
    </p>
    <nav class="kt-toc" aria-label="On this page">
      <a href="#issues">Questions and bugs</a>
      <a href="#security">Reporting a vulnerability</a>
      <a href="#contributing">Contributing</a>
      <a href="#experimental">What “experimental” means</a>
      <a href="#license">License</a>
    </nav>
  </section>

  <section class="kt-section kt-first" id="issues" aria-labelledby="issues-title">
    <div class="kt-section-head">
      <h2 id="issues-title">Questions and bugs</h2>
      <p>
        Ask questions and report bugs in the issue tracker of the project they concern. Do not post a
        suspected vulnerability there (see <a href="#security">reporting a vulnerability</a>).
      </p>
    </div>
    <div class="kt-grid" style="--kt-grid-min: 20rem">
      <a class="kt-tracker" href={java.issues}>
        <ProductIcon slug="kmip-java" />
        <span class="kt-tracker__text">
          <strong>{java.title} issues</strong>
          <span>github.com/keytend/keytend-kmip-java/issues</span>
        </span>
        <Icon name="external" class="kt-tracker__ext" />
      </a>
      <a class="kt-tracker" href={server.issues}>
        <ProductIcon slug="kmip-server" />
        <span class="kt-tracker__text">
          <strong>{server.title} issues</strong>
          <span>github.com/keytend/keytend-kmip-server/issues</span>
        </span>
        <Icon name="external" class="kt-tracker__ext" />
      </a>
    </div>
  </section>

  <section class="kt-section" id="security" aria-labelledby="security-title">
    <div class="kt-security">
      <div class="kt-security__main">
        <h2 id="security-title">Reporting a vulnerability</h2>
        <p>
          Email the report to{' '}
          <a class="kt-security__mail" href={`mailto:${project.securityEmail}`}>{project.securityEmail}</a>.
          Do not open a public issue, pull request or discussion for a suspected vulnerability.
        </p>
        <p>Please include:</p>
        <ul class="kt-list">
          <li>the affected version or commit (and, for keytend-kmip, the JDK version);</li>
          <li>what an attacker controls and what they gain;</li>
          <li>
            a synthetic reproduction. Never include real keys, master keys, passwords or
            certificates.
          </li>
        </ul>
      </div>
      <dl class="kt-security__facts">
        <div>
          <dt>Response goals<span class="sr-only">: </span></dt>
          <dd>
            keytend-kmip aims to acknowledge within 7 days, assess within 14 days, and ship a fixed
            release within 90 days of a confirmed report. No service level agreement backs these
            goals. keytend-kmip-server has no response-time commitment yet.
          </dd>
        </div>
        <div>
          <dt>Encryption<span class="sr-only">: </span></dt>
          <dd>
            Reports cannot be encrypted yet. The Keytend OpenPGP key has signing subkeys only.
          </dd>
        </div>
        <div>
          <dt>Disclosure<span class="sr-only">: </span></dt>
          <dd>
            For keytend-kmip, a fix ships as a new release with a GitHub security advisory. Keep the
            report private until it is published, or for 90 days if no date has been agreed.
          </dd>
        </div>
        <div>
          <dt>Policies<span class="sr-only">: </span></dt>
          <dd>
            <a href={java.security}>keytend-kmip security policy</a> ·{' '}
            <a href={server.security}>keytend-kmip-server security policy</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="kt-section" id="contributing" aria-labelledby="contrib-title">
    <div class="kt-section-head">
      <h2 id="contrib-title">Contributing</h2>
      <p>
        Each project has a single maintainer, so please <strong>open an issue before starting a pull
        request</strong>, to agree that the change is wanted and how it should look.
      </p>
    </div>
    <dl class="kt-facts">
      <div>
        <dt class="kt-name">keytend-kmip-server<span class="sr-only">: </span></dt>
        <dd>
          Build and test commands, the test suites and the image are in{' '}
          <a href="/kmip-server/docs/testing/">Testing</a>. The suites run
          the clients through the{' '}
          <a href="/kmip-server/docs/interop/">interoperability adapters</a>.
        </dd>
      </div>
      <div>
        <dt class="kt-name">keytend-kmip<span class="sr-only">: </span></dt>
        <dd>
          <code>./mvnw install</code> builds every module and runs the unit tests.{' '}
          <a href="/kmip-java/docs/validation/">Validation</a> describes the runs against real
          servers, and <a href="/kmip-java/docs/licensing/">licensing</a> covers
          source headers and third-party material.
        </dd>
      </div>
      <div>
        <dt>Bugs in other KMIP servers<span class="sr-only">: </span></dt>
        <dd>
          Report them to those servers’ maintainers.
        </dd>
      </div>
    </dl>
  </section>

  <section class="kt-section" id="experimental" aria-labelledby="exp-title">
    <div class="kt-exp">
      <div class="kt-section-head">
        <h2 id="exp-title">What “experimental” means</h2>
        <p>
          Both projects started as experiments in implementing the KMIP specification. They stay
          experimental in every release. Do not use them to protect real keys or data.
        </p>
      </div>

      <div class="kt-exp__grid">
        <div>
          <h3>Intended uses</h3>
          <ul class="kt-list">
            <li>Learning how KMIP works, from the application API down to TTLV.</li>
            <li>A KMIP server in CI pipelines and test environments.</li>
            <li>Testing KMIP client libraries, and products that use KMIP for key management such as Percona Server.</li>
            <li>Testing Java application code against an in-memory KMIP server.</li>
          </ul>
        </div>
        <div>
          <h3>Limits</h3>
          <ul class="kt-list kt-list--no">
            <li>The server implements a subset of KMIP 1.0 to 2.1 and has no conformance certification.</li>
            <li>Neither project has had an independent security audit. The server has a FIPS mode, but it is not FIPS 140-3 validated.</li>
            <li>The server has no high availability, HSM support or hot reload.</li>
            <li>There is no service level agreement. Security fixes are best effort.</li>
          </ul>
        </div>
      </div>

      <dl class="kt-facts kt-exp__facts">
        <div>
          <dt>Versions<span class="sr-only">: </span></dt>
          <dd>
            keytend-kmip’s compatibility promises cover the API and stored formats and start at
            0.10.0; a pre-release such as 0.10.0-rc.1 makes none. keytend-kmip-server fixes go into
            the next release candidate, and no
            older release line is maintained.
          </dd>
        </div>
        <div>
          <dt>What “tested” means<span class="sr-only">: </span></dt>
          <dd>
            “Tested” means a project’s own tests pass against the servers or clients named. It does not
            certify either project, and it does not show that they suit production.
          </dd>
        </div>
        <div>
          <dt>Test fixtures<span class="sr-only">: </span></dt>
          <dd>
            The in-memory server (<code>keytend-kmip-testing</code>) and the test certificates in
            both repositories are for tests only. They do not protect what they hold.
          </dd>
        </div>
        <div>
          <dt>Read more<span class="sr-only">: </span></dt>
          <dd>
            <a href="/kmip-server/docs/status/">Server project status</a> ·{' '}
            <a href="/kmip-java/docs/compatibility/">SDK compatibility and support</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="kt-section" id="license" aria-labelledby="license-title">
    <div class="kt-license">
      <div>
        <h2 id="license-title">License</h2>
        <p>
          Both projects are licensed under the{' '}
          <a href={project.licenseUrl}>Apache License, Version 2.0</a>. Each
          repository’s NOTICE file keeps third-party attributions. The server’s container image also
          contains Red Hat UBI packages, redistributable under the UBI End User License Agreement.
        </p>
      </div>
      <div class="kt-license__links" data-pagefind-ignore>
        <a class="kt-button kt-button--secondary" href={repoFile('kmip-java', 'LICENSE')}><span>keytend-kmip LICENSE</span></a>
        <a class="kt-button kt-button--secondary" href={repoFile('kmip-server', 'LICENSE')}><span>keytend-kmip-server LICENSE</span></a>
      </div>
    </div>
  </section>
</SitePage>

<style>
  .kt-toc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .kt-toc a {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--kt-border-strong);
    border-radius: 999px;
    font-size: var(--kt-text-sm);
    color: var(--kt-text);
    text-decoration: none;
  }
  .kt-toc a:hover {
    border-color: var(--kt-brand-line);
    color: var(--kt-text-strong);
  }
  .kt-first {
    margin-top: 1.5rem;
  }

  .kt-tracker {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--kt-border);
    border-radius: var(--kt-radius-lg);
    background-color: var(--kt-surface);
    text-decoration: none;
    min-width: 0;
  }
  .kt-tracker:hover {
    border-color: var(--kt-brand-line);
  }
  .kt-tracker__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .kt-tracker__text strong {
    font-family: var(--kt-font-mono);
    font-weight: 500;
    color: var(--kt-text-strong);
  }
  .kt-tracker__text span {
    font-size: var(--kt-text-xs);
    color: var(--kt-text-muted);
    overflow-wrap: anywhere;
  }
  :global(.kt-tracker__ext) {
    margin-inline-start: auto;
    flex: none;
    color: var(--kt-text-muted);
  }

  .kt-security {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 3rem;
    padding: clamp(1.25rem, 1rem + 2vw, 2.25rem);
    border: 1px solid var(--kt-brand-line);
    border-radius: var(--kt-radius-lg);
    background:
      linear-gradient(var(--kt-brand-soft), var(--kt-brand-soft)),
      var(--kt-surface);
  }
  .kt-security__main > * + * {
    margin-top: 0.875rem !important;
  }
  .kt-security__main h2 {
    margin-top: 0 !important;
    font-size: var(--kt-text-2xl);
  }
  .kt-security__mail {
    font-family: var(--kt-font-mono);
    font-weight: 500;
    color: var(--kt-brand);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  .kt-security__mail:hover {
    text-decoration-thickness: 2px;
  }
  .kt-security__facts {
    margin: 0;
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .kt-security__facts dt {
    font-size: var(--kt-text-sm);
    font-weight: 600;
    color: var(--kt-text-strong);
  }
  .kt-security__facts dd {
    margin: 0.25rem 0 0;
    font-size: var(--kt-text-sm);
    line-height: 1.6;
  }
  @media (min-width: 62rem) {
    .kt-security {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
    .kt-security__facts {
      padding-inline-start: 2rem;
      border-inline-start: 1px solid var(--kt-border);
    }
  }

  .kt-exp {
    padding: clamp(1.25rem, 1rem + 2vw, 2.25rem);
    border: 1px solid var(--kt-experimental-line);
    border-radius: var(--kt-radius-lg);
    background-color: var(--kt-experimental-bg);
  }
  .kt-exp__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem 2.5rem;
  }
  .kt-exp__grid h3 {
    margin-bottom: 0.75rem;
    font-size: var(--kt-text-md);
  }
  .kt-exp__grid .kt-list {
    font-size: var(--kt-text-sm);
  }
  .kt-list--no > li::before {
    background-color: var(--kt-experimental);
    border-radius: 50%;
    transform: none;
  }
  @media (min-width: 52rem) {
    .kt-exp__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .kt-exp__facts {
    margin-top: 2rem;
    background-color: var(--kt-bg);
  }

  .kt-license {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem 3rem;
    align-items: end;
    padding-top: 2rem;
    border-top: 1px solid var(--kt-border);
  }
  .kt-license h2 {
    margin-top: 0 !important;
    font-size: var(--kt-text-2xl);
  }
  .kt-license p:not(.kt-eyebrow) {
    margin-top: 0.75rem;
    max-width: 46rem;
  }
  .kt-license__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  @media (min-width: 62rem) {
    .kt-license {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
