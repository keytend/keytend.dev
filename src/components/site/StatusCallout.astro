---
// The amber "experimental" callout used on product and download pages.
interface Props {
  title: string;
  id?: string;
}
const { title, id } = Astro.props;
---

<div class="kt-callout" role="note" aria-label={title} id={id}>
  <svg class="kt-callout__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <path
      d="M9 3h6M10 3v5.2L4.6 17.4A2.4 2.4 0 0 0 6.7 21h10.6a2.4 2.4 0 0 0 2.1-3.6L14 8.2V3"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path d="M7.2 15h9.6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"
    ></path>
  </svg>
  <div class="kt-callout__body">
    <p class="kt-callout__title">{title}</p>
    <slot />
  </div>
</div>

<style>
  /* The box fits its text (capped at a readable measure) instead of running
     the full page width with the right half empty. */
  .kt-callout {
    display: flex;
    width: fit-content;
    max-width: 100%;
    gap: 0.875rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--kt-experimental-line);
    border-radius: var(--kt-radius-lg);
    background-color: var(--kt-experimental-bg);
    color: var(--kt-text-strong);
  }
  .kt-callout__icon {
    flex: none;
    margin-top: 0.125rem;
    color: var(--kt-experimental);
  }
  .kt-callout__title {
    font-weight: 600;
    color: var(--kt-experimental-text);
  }
  /* Body-size text at a readable measure, however wide the callout is. */
  .kt-callout__body {
    min-width: 0;
    max-width: 72ch;
    font-size: var(--kt-text-base);
    line-height: 1.65;
  }
  .kt-callout__body :global(p + p),
  .kt-callout__body :global(p + ul) {
    margin-top: 0.625rem;
  }
  .kt-callout__body :global(.kt-callout__title + *) {
    margin-top: 0.375rem;
  }
  /* On a phone the icon sits beside the title and the text below uses the full width. */
  @media (max-width: 31.24rem) {
    .kt-callout {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0 0.625rem;
      align-items: center;
    }
    .kt-callout__icon {
      margin-top: 0;
    }
    .kt-callout__body {
      display: contents;
    }
    .kt-callout__body > :global(:not(.kt-callout__title)) {
      grid-column: 1 / -1;
    }
  }
  .kt-callout .kt-callout__body :global(a) {
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
