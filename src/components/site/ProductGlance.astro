---
// The "at a glance" card in a product page's hero: the product's key facts
// from src/data/products.ts.
import ProductIcon from './ProductIcon.astro';
import { products, type ProductSlug } from '../../data/products';

interface Props {
  slug: ProductSlug;
}
const { slug } = Astro.props;
const p = products[slug];
---

<section class="kt-glance" aria-labelledby={`kt-glance-${slug}`}>
  <div class="kt-glance__head">
    <ProductIcon slug={slug} size={2.25} />
    <p id={`kt-glance-${slug}`}>At a glance</p>
  </div>
  <dl>
    {
      p.glance.map(([k, v]) => (
        <div>
          <dt>{k}<span class="sr-only">: </span></dt>
          <dd>
            {v}
            {k === 'Get it' && <a class="kt-link-arrow kt-glance__link" href={`/downloads/#${p.name}`}>How to download and verify</a>}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .kt-glance__link {
    display: flex !important;
    width: fit-content;
    margin-top: 0.25rem;
  }
  .kt-glance {
    padding: 1.25rem 1.375rem 1.375rem;
    border: 1px solid var(--kt-border);
    border-radius: var(--kt-radius-lg);
    background-color: var(--kt-surface);
    box-shadow: var(--kt-shadow-card);
  }
  .kt-glance__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--kt-border);
  }
  .kt-glance__head p {
    font-size: var(--kt-text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--kt-text-muted);
  }
  /* One column beside the hero copy and on phones; two below the hero on
     tablets, with an odd last fact spanning both. */
  dl {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.875rem 1.5rem;
    margin: 1rem 0 0;
  }
  @media (min-width: 34rem) and (max-width: 71.99rem) {
    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    dl > div:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  dt {
    font-size: var(--kt-text-xs);
    color: var(--kt-text-muted);
  }
  dd {
    margin: 0.125rem 0 0;
    font-size: var(--kt-text-sm);
    line-height: 1.5;
    color: var(--kt-text-strong);
  }
</style>
