---
// The Keytend mark: a "K" whose upper arm ends in a key ring. Drawn on a
// 32-unit grid; identical to src/assets/logo.svg and public/favicon.svg.
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  class:list={['kt-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="7.5" fill="#4f5ee0"></rect>
  <g fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
    <path d="M10.5 7.5v17"></path>
    <path d="M10.5 18 17.9 11.9"></path>
    <circle cx="20.8" cy="9.6" r="3.3"></circle>
    <path d="M14.3 14.9 21.5 24.5"></path>
  </g>
</svg>

<style>
  .kt-mark {
    flex: none;
    display: block;
  }
</style>
