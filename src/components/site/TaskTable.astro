---
// "I want to… / Read" rows, as in the product READMEs. Each row is one link.
interface Props {
  rows: Array<{ want: string; read: string; href: string }>;
  label?: string;
}
const { rows, label = 'I want to…' } = Astro.props;
---

<div class="kt-tasks">
  <div class="kt-tasks__head" aria-hidden="true" data-pagefind-ignore>
    <span>{label}</span>
    <span>Read</span>
  </div>
  <ul>
    {
      rows.map((row) => (
        <li>
          <a class="kt-tasks__link" href={row.href}>
            <span class="kt-tasks__want">{row.want}</span>
            <span class="kt-tasks__read">
              <span class="sr-only">: read </span>
              {row.read}
              <svg class="kt-tasks__arrow" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true" focusable="false">
                <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .kt-tasks {
    border: 1px solid var(--kt-border);
    border-radius: var(--kt-radius-lg);
    background-color: var(--kt-surface);
    overflow: hidden;
  }
  .kt-tasks__head {
    display: none;
    padding: 0.625rem 1.25rem;
    border-bottom: 1px solid var(--kt-border);
    font-size: var(--kt-text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--kt-text-muted);
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li + li {
    border-top: 1px solid var(--kt-border);
  }
  a {
    display: grid;
    gap: 0.125rem;
    padding: 0.875rem 1.25rem;
    text-decoration: none;
    color: var(--kt-text);
  }
  a:hover {
    background-color: var(--kt-surface-2);
  }
  a:focus-visible {
    outline-offset: -3px;
  }
  .kt-tasks__want {
    color: var(--kt-text-strong);
    font-weight: 500;
  }
  .kt-tasks__read {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--kt-brand);
    font-weight: 600;
    font-size: var(--kt-text-sm);
  }
  .kt-tasks__arrow {
    flex: none;
    transition: transform 120ms ease;
  }
  a:hover .kt-tasks__arrow {
    transform: translateX(2px);
  }
  @media (min-width: 46rem) {
    .kt-tasks__head {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 1.5rem;
    }
    a {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 1.5rem;
      align-items: baseline;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .kt-tasks__arrow {
      transition: none;
    }
  }
</style>
