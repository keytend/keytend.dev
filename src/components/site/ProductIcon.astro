---
// One icon language for the two products, used wherever a product is named
// with an icon (home cards, header menus, site menu, community, product
// pages): a periwinkle tile holding a line glyph. The SDK is code ("</>"), the
// server is a stacked server.
import type { ProductSlug } from '../../data/products';

interface Props {
  slug: ProductSlug;
  /** Tile size in rem. The glyph scales with it. */
  size?: number;
  class?: string;
}
const { slug, size = 2.5, class: className } = Astro.props;
---

<span class:list={['kt-picon', className]} style={`--kt-picon-size: ${size}rem`} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    {
      slug === 'kmip-java' ? (
        <>
          <path d="M8 7.5 3.5 12 8 16.5" />
          <path d="M16 7.5 20.5 12 16 16.5" />
          <path d="M13.5 5.5 10.5 18.5" />
        </>
      ) : (
        <>
          <rect x="3.5" y="4" width="17" height="7" rx="1.75" />
          <rect x="3.5" y="13" width="17" height="7" rx="1.75" />
          <path d="M7.5 7.5h.01M7.5 16.5h.01M11 7.5h5.5M11 16.5h5.5" />
        </>
      )
    }
  </svg>
</span>

<style>
  .kt-picon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--kt-picon-size);
    height: var(--kt-picon-size);
    border: 1px solid var(--kt-brand-line);
    border-radius: calc(var(--kt-picon-size) * 0.26);
    background-color: var(--kt-brand-soft);
    color: var(--kt-brand);
  }
  svg {
    width: 55%;
    height: 55%;
  }
</style>
